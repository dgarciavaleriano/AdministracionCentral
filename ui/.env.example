# Copia este fichero como .env y rellena los valores para tu entorno local.
# El fichero .env nunca se sube al repositorio.

# URL base de la API (ej: http://127.0.0.1:8080)
API_BASE_URL=http://127.0.0.1:8080

# Timeout en segundos para las peticiones al API
API_TIMEOUT=5

# Secreto para firmar el almacenamiento de sesión de NiceGUI.
# Genera uno seguro, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
NICEGUI_STORAGE_SECRET=cambia-esto-por-un-secreto-seguro
