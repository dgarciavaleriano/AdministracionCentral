# Plantilla de configuración del frontal. Cópiala a .env y ajusta lo que necesites:
#
#   Copy-Item ui\.env.example ui\.env
#
# Todas las claves tienen valor por defecto en ui/config/settings.py, así que el
# frontal arranca sin .env (con un aviso sobre el secreto de sesión, ver abajo).
# Este fichero documenta qué se puede configurar.
# NO pongas secretos reales aquí: .env.example SÍ se sube a git.

# URL base de la API. 127.0.0.1 y no "localhost": en Windows "localhost"
# resuelve primero a ::1 y la API publica solo en IPv4, así que cada conexión
# esperaría ~30 s.
API_BASE_URL=http://127.0.0.1:8080

# Timeout en segundos para las peticiones a la API.
API_TIMEOUT=5

# Dónde escucha el propio frontal. Llevan prefijo UI_ a propósito: HOST y PORT
# son de la API, y NICEGUI_HOST / NICEGUI_PORT las escribe NiceGUI en el entorno
# para el subproceso del modo reload.
UI_HOST=127.0.0.1
UI_PORT=8000

# Secreto para firmar el almacenamiento de sesión de NiceGUI. Si no lo defines
# se usa el de desarrollo de ui/config/settings.py, que está en el repositorio:
# el frontal funciona en local, pero main.py avisa al arrancar. El valor de
# abajo también está publicado, así que el aviso sigue saliendo hasta que pongas
# uno propio.
# Genera uno seguro, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
NICEGUI_STORAGE_SECRET=cambia-esto-por-un-secreto-seguro
