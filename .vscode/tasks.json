    {
      "label": "Bases de datos",
      "detail": "Levanta db (5432) y db_test (5433) y espera a que acepten conexiones",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "API FastAPI",
      "type": "shell",
      "command": "uv run python -m uvicorn app:app --app-dir src --reload --host 127.0.0.1 --port 8080",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
