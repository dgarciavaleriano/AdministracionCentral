// Ctrl+Shift+B arranca todo. El resto de tareas: Ctrl+Shift+P > Tasks: Run Task.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Base de datos",
      "type": "shell",
      "command": "docker compose up -d --wait db",
      "problemMatcher": []
    },
    {
      "label": "Migraciones",
      "type": "shell",
      "command": "uv run python -m alembic upgrade head",
      "problemMatcher": []
    },
    {
      "label": "API",
      "type": "shell",
      "command": "uv run python src/main.py",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      // En orden: base de datos, migraciones y la API.
      "label": "Arrancar todo",
      "dependsOn": ["Base de datos", "Migraciones", "API"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "uv run python -m pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
