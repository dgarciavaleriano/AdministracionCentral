# Plantilla de configuración. Cópiala a .env y ajusta lo que necesites:
#
#   Copy-Item .env.example .env
#
# Todas las claves tienen valor por defecto en src/config/settings.py, así que
# el proyecto arranca sin .env. Este fichero documenta qué se puede configurar.
# NO pongas secretos reales aquí: .env.example SÍ se sube a git.

HOST=localhost
PORT=8080
LOG_LEVEL=INFO
API_VERSION=1.0.0

# Credenciales de desarrollo del docker-compose. En CI y en despliegue estas
# variables se definen en el entorno y tienen prioridad sobre este fichero.
# 127.0.0.1 y no "localhost": en Windows "localhost" resuelve primero a ::1 y
# docker publica solo en IPv4, así que la conexión se cuelga ~30 s.
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/administracion
TEST_DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5433/administracion_test

# Configuración de rotación de proveedores y modelos del Core de IA (Patrón Registry)
LLM_PROVIDERS=[{"provider": "groq", "model": "llama3-70b-8192", "prefix": "GROQ_API_KEY"}, {"provider": "gemini", "model": "gemini-1.5-flash", "prefix": "GEMINI_API_KEY"}, {"provider": "openai", "model": "gpt-4o-mini", "prefix": "OPENAI_API_KEY"}]

# API Keys de los Proveedores
GROQ_API_KEY_1="tu_clave_groq_1"
GROQ_API_KEY_2="tu_clave_groq_2"
GEMINI_API_KEY_1="tu_clave_gemini_1"
GEMINI_API_KEY_2="tu_clave_gemini_2"
OPENAI_API_KEY_1="tu_clave_openai_1"
OPENAI_API_KEY_2="tu_clave_openai_2"