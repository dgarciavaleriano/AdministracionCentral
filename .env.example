# Copia este fichero a .env para cambiar la configuración de la API.
# Todo tiene valor por defecto (src/config/settings.py), así que .env es opcional.
# No pongas secretos reales: este fichero sí se sube a git.

HOST=localhost
PORT=8080
LOG_LEVEL=INFO
API_VERSION=1.0.0
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/administracion
