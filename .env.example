# Copia este fichero a .env y rellena los valores reales.
# El fichero .env está ignorado por git y nunca debe subirse al repositorio.

# URL base del API FastAPI
API_BASE_URL=http://127.0.0.1:8080

# Tiempo máximo de espera para llamadas al API (segundos)
API_TIMEOUT=10

# Secreto usado por NiceGUI para firmar/cifrar el almacenamiento de usuario.
# Genera un valor seguro con: python -c "import secrets; print(secrets.token_hex(32))"
NICEGUI_STORAGE_SECRET=change-me-with-a-secure-random-value
